{
  "name": "selfcloud-web",
  "private": true,
  "version": "0.0.0",
  "description": "Selfcloud web interface",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-source.mjs && node scripts/check-licences.mjs && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && vitest run",
    "test": "vitest run",
    "postbuild": "node scripts/check-dist.mjs && node scripts/write-dist-gitignore.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "22.20.5",
    "svelte": "5.57.3",
    "svelte-check": "4.7.7",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@fontsource-variable/noto-sans-hebrew": "5.3.0"
  }
}
