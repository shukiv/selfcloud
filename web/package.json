{
  "name": "selfcloud-web",
  "private": true,
  "version": "0.0.0",
  "description": "Selfcloud web interface, React 18 and Ant Design 5",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json && node scripts/check-source.mjs && node scripts/check-licences.mjs && node scripts/check-keys.mjs && vitest run",
    "test": "vitest run",
    "postbuild": "node scripts/check-dist.mjs && node scripts/write-dist-gitignore.mjs"
  },
  "dependencies": {
    "@ant-design/colors": "7.2.1",
    "@tanstack/react-query": "5.105.0",
    "antd": "5.29.3",
    "i18next": "26.5.11",
    "lucide-react": "1.64.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.1.9",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
